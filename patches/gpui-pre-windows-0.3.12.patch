+#[cfg(test)]
+mod activation_tests {
+    use std::{cell::Cell, rc::Rc};
+
+    use super::{Callbacks, HWND};
+
+    #[test]
+    fn queued_activation_does_not_run_after_close_begins() {
+        let callbacks = Callbacks::default();
+        let owner = crate::dialog::DialogOwner::new(HWND::default());
+        let calls = Rc::new(Cell::new(0));
+        let count = Rc::clone(&calls);
+        callbacks.active_status_change.set(Some(Box::new(move |_| {
+            count.set(count.get() + 1);
+        })));
+
+        callbacks.activated(true, &owner);
+        owner.close();
+        callbacks.activated(false, &owner);
+        assert_eq!(calls.get(), 1);
+    }
+
+    #[test]
+    fn closing_during_activation_does_not_reattach_the_callback() {
+        let callbacks = Callbacks::default();
+        let owner = crate::dialog::DialogOwner::new(HWND::default());
+        let closing = Rc::clone(&owner);
+        callbacks
+            .active_status_change
+            .set(Some(Box::new(move |_| closing.close())));
+
+        callbacks.activated(true, &owner);
+        assert!(callbacks.active_status_change.take().is_none());
+    }
+}

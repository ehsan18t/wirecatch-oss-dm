{
  "name": "Night",
  "description": "Large files overnight",
  "max_concurrent": {
    "source": "own",
    "value": 2
  },
  "speed_limit": {
    "source": "own",
    "value": 1048576
  },
  "connections": {
    "source": "own",
    "value": 4
  },
  "proxy": {
    "source": "own",
    "value": {
      "kind": "server",
      "id": 2
    }
  },
  "exceptions": {
    "source": "own",
    "value": {
      "system": false,
      "app_hosts": true,
      "use_hosts": true,
      "hosts": [
        "intranet.example",
        "10.*"
      ]
    }
  },
  "add_downloads": {
    "kind": "auto",
    "enabled": true,
    "sites": [
      "example.com",
      "*.corp.example",
      "10.0.0.0/8",
      "<local>"
    ],
    "file_names": [
      "*.iso"
    ],
    "file_name_syntax": "wildcards",
    "file_types": [
      "tar.gz"
    ],
    "categories": [
      "video"
    ],
    "protocols": [
      "ftp"
    ]
  },
  "schedule": {
    "start": {
      "hour": 1,
      "minute": 30
    },
    "stop": null,
    "days": []
  },
  "notify": "when_done"
}

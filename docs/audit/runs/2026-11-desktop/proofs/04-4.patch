+
+/// 04-4: Resume all closes the question (D88.3), and a late answer never touches a finished row.
+#[tokio::test(flavor = "multi_thread", worker_threads = 2)]
+async fn resume_all_closes_the_question() -> TestResult {
+    let server = server().await;
+    let h = Harness::new().await?;
+    let dir = folder_with(&h, &same_size())?;
+    let mut events = h.manager.subscribe();
+    let row = add_into(&h, server.url("report").as_str(), &dir).await?;
+    let question = asked(&mut events).await?;
+    h.wait_status(row.id, DownloadStatus::Paused).await;
+    std::fs::remove_file(dir.join(NAME))?;
+    h.manager.resume_all()?;
+    h.wait_status(row.id, DownloadStatus::Completed).await;
+    let open = h.manager.pending_file_exists().len();
+    println!("OPEN after it finished {open}");
+    let late = h.manager.answer_file_exists(question.id, answer(FileExistsChoice::Replace, false));
+    println!("LATE {late:?} status {:?}", h.row(row.id).status);
+    assert_eq!(open, 0, "the question outlived Resume all");
+    Ok(())
+}

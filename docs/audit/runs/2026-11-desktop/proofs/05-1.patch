+/// 05-1: two questions about one file, both answered Replace, must not end on one path.
+#[tokio::test(flavor = "multi_thread", worker_threads = 4)]
+async fn two_answers_of_replace_never_share_a_path() -> TestResult {
+    const BIG: usize = 4 * 1024 * 1024;
+    let config = || Config {
+        ranges: true,
+        per_connection_bps: Some(128 * KIB),
+        ..Config::default()
+    };
+    let one = TestServer::start(vec![0xAA; BIG], config()).await;
+    let two = TestServer::start(vec![0xBB; BIG], config()).await;
+    let h = Harness::new().await?;
+    let dir = folder_with(&h, b"older file")?;
+    let mut events = h.manager.subscribe();
+    let first = add_into(&h, one.url("a").as_str(), &dir).await?;
+    let q1 = asked(&mut events).await?;
+    let second = add_into(&h, two.url("b").as_str(), &dir).await?;
+    let q2 = asked(&mut events).await?;
+    h.manager.answer_file_exists(q1.id, answer(FileExistsChoice::Replace, false))?;
+    // The first run has written bytes and saved its resume file before the second is answered.
+    h.wait_for(first.id, "the first bytes", |r| r.done > 0).await;
+    let path = dir.join(NAME);
+    let [_, state] = crate::common::partial_files(&path.to_string_lossy());
+    crate::common::wait_until("the first run's resume file", || state.exists().then_some(())).await;
+    h.manager.answer_file_exists(q2.id, answer(FileExistsChoice::Replace, false))?;
+    let (a, b) = (h.manager.get_download(first.id)?, h.manager.get_download(second.id)?);
+    println!("PATHS same={} {:?} {:?}", a.path == b.path, a.status, b.status);
+    h.wait_for(second.id, "the second run's start", |r| {
+        r.done > 0 || matches!(r.status, DownloadStatus::Failed | DownloadStatus::Completed)
+    })
+    .await;
+    one.configure(|c| c.per_connection_bps = None);
+    two.configure(|c| c.per_connection_bps = None);
+    let ended = |s| matches!(s, DownloadStatus::Completed | DownloadStatus::Failed);
+    let a = h.wait_for(first.id, "ended", move |r| ended(r.status)).await;
+    let b = h.wait_for(second.id, "ended", move |r| ended(r.status)).await;
+    println!("END {:?} {:?} / {:?} {:?}", a.status, a.error.map(|e| e.message), b.status, b.error.map(|e| e.message));
+    let bytes = std::fs::read(&path)?;
+    let count = |v: u8| bytes.iter().filter(|x| **x == v).count();
+    println!("FILE len {} aa {} bb {} zero {}", bytes.len(), count(0xAA), count(0xBB), count(0));
+    assert_ne!(a.path, b.path, "two downloads share one path");
+    Ok(())
+}

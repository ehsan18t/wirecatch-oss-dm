+    #[test]
+    fn an_update_does_not_overwrite_the_program_named_by_an_inherited_variable() {
+        let dir = tempfile::tempdir().unwrap();
+        let other = dir.path().join("Editor.AppImage");
+        std::fs::write(&other, b"#!/bin/sh\n# the editor\n").unwrap();
+        let installer = dir.path().join("new.AppImage");
+        std::fs::write(&installer, b"#!/bin/sh\n# wirecatch\n").unwrap();
+        // SAFETY: no other test in this binary reads or writes this variable while it runs alone.
+        unsafe { std::env::set_var(crate::appimage::APPIMAGE_VAR, &other) };
+        let _ = super::replace_appimage(&installer);
+        // SAFETY: as above.
+        unsafe { std::env::remove_var(crate::appimage::APPIMAGE_VAR) };
+        assert_eq!(std::fs::read(&other).unwrap(), b"#!/bin/sh\n# the editor\n");
+    }

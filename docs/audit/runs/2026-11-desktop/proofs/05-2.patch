+/// 05-2: a name that comes from the link, not typed and not named by the server, meets the setting too (D96).
+#[tokio::test(flavor = "multi_thread", worker_threads = 2)]
+async fn a_name_from_the_link_is_asked_about_too() -> TestResult {
+    let server = server().await;
+    let h = Harness::new().await?;
+    let dir = folder_with(&h, &same_size())?;
+    let row = h
+        .add_with(server.url(NAME).as_str(), |r| {
+            r.folder = Some(dir.to_string_lossy().into_owned());
+        })
+        .await?;
+    println!("PROVISIONAL {}", row.file_name);
+    let end = h
+        .wait_for(row.id, "a question or the end", |r| {
+            matches!(r.status, DownloadStatus::Paused | DownloadStatus::Completed)
+        })
+        .await;
+    let open = h.manager.pending_file_exists().len();
+    println!("ASK {:?} {} questions {open}", end.status, end.file_name);
+    assert_eq!(open, 1, "the setting Ask asked nothing");
+    Ok(())
+}
+
+/// 05-2: the same with the setting on Replace.
+#[tokio::test(flavor = "multi_thread", worker_threads = 2)]
+async fn a_name_from_the_link_replaces_when_the_setting_says_so() -> TestResult {
+    let server = server().await;
+    let h = Harness::new().await?;
+    choose(&h, WhenFileExists::Replace)?;
+    let dir = folder_with(&h, &same_size())?;
+    let row = h
+        .add_with(server.url(NAME).as_str(), |r| {
+            r.folder = Some(dir.to_string_lossy().into_owned());
+        })
+        .await?;
+    let done = h.wait_status(row.id, DownloadStatus::Completed).await;
+    println!("REPLACE {} old file kept {}", done.file_name, std::fs::read(dir.join(NAME))? == same_size());
+    assert_eq!(Path::new(&done.path), dir.join(NAME));
+    Ok(())
+}

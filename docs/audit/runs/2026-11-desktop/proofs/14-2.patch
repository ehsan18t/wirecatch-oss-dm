+//! A large HLS master playlist: work counted by allocations (`CODECS="x"` makes each `audio_only` allocate), and, in the ignored test, wall time printed for a size taken from the environment.
+
+use std::alloc::{GlobalAlloc, Layout, System};
+use std::sync::atomic::{AtomicU64, Ordering};
+use std::time::Instant;
+
+use wirecatch_engine::{CancellationToken, DownloadOptions};
+use wirecatch_streams::{Choice, PrivateNetwork, StreamInfo, inspect};
+use wirecatch_test_support::TestResult;
+use wirecatch_test_support::files::FileServer;
+
+static ALLOCATIONS: AtomicU64 = AtomicU64::new(0);
+
+struct Counting;
+
+// SAFETY: every call goes to the system allocator unchanged.
+unsafe impl GlobalAlloc for Counting {
+    unsafe fn alloc(&self, layout: Layout) -> *mut u8 {
+        ALLOCATIONS.fetch_add(1, Ordering::Relaxed);
+        // SAFETY: as the caller's contract.
+        unsafe { System.alloc(layout) }
+    }
+    unsafe fn dealloc(&self, block: *mut u8, layout: Layout) {
+        // SAFETY: as the caller's contract.
+        unsafe { System.dealloc(block, layout) };
+    }
+}
+
+#[global_allocator]
+static COUNTING: Counting = Counting;
+
+const MEDIA: &str = "#EXTM3U\n#EXTINF:1,\ns.ts\n#EXT-X-ENDLIST\n";
+
+async fn inspect_master(line: &str, qualities: usize) -> TestResult<StreamInfo> {
+    let server = FileServer::start().await;
+    let text = format!("#EXTM3U\n{}", line.repeat(qualities));
+    eprintln!("{qualities} qualities, {} bytes", text.len());
+    server.put_typed("m.m3u8", text, "application/vnd.apple.mpegurl");
+    server.put_typed("a", MEDIA, "application/vnd.apple.mpegurl");
+    Ok(inspect(
+        &server.url("m.m3u8"),
+        &DownloadOptions::default(),
+        PrivateNetwork::Auto,
+        CancellationToken::new(),
+    )
+    .await?)
+}
+
+#[tokio::test]
+async fn inspecting_a_master_does_work_in_proportion_to_its_qualities() -> TestResult {
+    const QUALITIES: u64 = 4_000;
+    let before = ALLOCATIONS.load(Ordering::Relaxed);
+    let info = inspect_master("#EXT-X-STREAM-INF:CODECS=\"x\"\na\n", 4_000).await?;
+    let spent = ALLOCATIONS.load(Ordering::Relaxed) - before;
+    eprintln!("{} video tracks, {spent} allocations", info.video.len());
+    assert!(
+        spent <= 200 * QUALITIES,
+        "{spent} allocations to inspect {QUALITIES} qualities"
+    );
+    Ok(())
+}
+
+/// `WC_QUALITIES=<n> WC_LINE=plain|codecs`: wall time of `inspect`, then of the `extension` loop `media::choice::from_stream` runs for qualities with no height.
+#[ignore = "a reproduction that prints wall time"]
+#[tokio::test(flavor = "multi_thread")]
+async fn wall_time_of_inspecting_a_large_master() -> TestResult {
+    let qualities: usize = std::env::var("WC_QUALITIES")?.parse()?;
+    let line = if std::env::var("WC_LINE").as_deref() == Ok("codecs") {
+        "#EXT-X-STREAM-INF:CODECS=\"x\"\na\n"
+    } else {
+        "#EXT-X-STREAM-INF:\na\n"
+    };
+    let started = Instant::now();
+    let info = inspect_master(line, qualities).await?;
+    eprintln!("inspect took {:?}", started.elapsed());
+    let started = Instant::now();
+    let mut mp4 = 0usize;
+    for video in &info.video {
+        let ext = info.extension(&Choice::Track(video.id.clone()), &Choice::Skip, true);
+        mp4 += usize::from(ext == "mp4");
+    }
+    eprintln!("extension loop took {:?} ({mp4} mp4)", started.elapsed());
+    Ok(())
+}

+#[cfg(all(test, windows))]
+mod audit_28_2 {
+    use super::*;
+    use std::os::windows::fs::OpenOptionsExt;
+
+    #[test]
+    fn replacing_a_file_another_program_holds_does_not_blame_the_folder() {
+        let dir = std::env::temp_dir().join(format!("audit-28-2-{}", std::process::id()));
+        std::fs::create_dir_all(&dir).unwrap();
+        let (part, target) = (dir.join("f.bin.wcpart"), dir.join("f.bin"));
+        std::fs::write(&part, b"new").unwrap();
+        std::fs::write(&target, b"old").unwrap();
+        const FILE_SHARE_READ: u32 = 1;
+        let held = std::fs::OpenOptions::new().read(true).share_mode(FILE_SHARE_READ).open(&target).unwrap();
+        let source = std::fs::rename(&part, &target).unwrap_err();
+        println!("kind={:?} raw={:?}", source.kind(), source.raw_os_error());
+        drop(held);
+        let error = EngineError::Io { action: wirecatch_engine::IoAction::Finish, path: target.clone(), source };
+        let told = describe(&error, &dir, Worked::Before);
+        std::fs::remove_dir_all(&dir).unwrap();
+        assert_ne!(told.fix, Some(FixAction::ChooseFolder), "{}", told.message);
+    }
+}

+/// Reads the app's own `config`, whose crate needs GPUI, and sets what it asks for.
+#[tokio::test(flavor = "multi_thread", worker_threads = 2)]
+async fn audit_proof_the_app_tests_a_working_proxy() -> TestResult {
+    let app = include_str!("../../../desktop/src/backend.rs");
+    let site = fast_server(KIB).await?;
+    let url = site.url("ping");
+    let tweak = Arc::new(move |config: wirecatch_core::ManagerConfig| {
+        if app.contains("with_official_proxy_test") {
+            config.with_proxy_test_url(url.clone())
+        } else {
+            config
+        }
+    });
+    let h = Harness::configured(tweak).await?;
+    let socks = socks_with_login().await;
+    let settings = socks_profile("Office", &socks, "alice");
+    assert_eq!(
+        h.manager
+            .test_proxy_server(None, draft(settings, Some("secret")))
+            .await?,
+        ProxyTestResult::Works
+    );
+    Ok(())

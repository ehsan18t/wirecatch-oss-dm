+/// 17-2: Replace on a name whose extension differs from the planned one places the finished file.
+#[tokio::test(flavor = "multi_thread", worker_threads = 2)]
+async fn proof_replace_with_another_extension_places_the_waiting_file() -> TestResult {
+    let server = FileServer::start().await;
+    hls(&server, false, false);
+    let h = Harness::new().await?;
+    let mut ui = h.manager.subscribe();
+    let capture = media_capture(
+        server.url("hls/master.m3u8"),
+        MediaKind::Hls,
+        Some("Holiday clip"),
+    );
+    h.manager
+        .add_capture(NewDownload {
+            handover_id: "first".into(),
+            ..capture.clone()
+        })
+        .await?;
+    let choice = choice_requested(&mut ui).await;
+    h.manager
+        .choose_media(choice.id, select(&choice.options[0].id))
+        .await?;
+    let first = h.manager.list_downloads().remove(0);
+    let first = h.wait_status(first.id, DownloadStatus::Completed).await;
+    let finished = std::path::Path::new(&first.path);
+    let folder = finished.parent().unwrap().to_path_buf();
+    let finished_ext = finished.extension().unwrap().to_string_lossy().into_owned();
+    std::fs::write(folder.join(format!("clip.{finished_ext}")), b"older")?;
+
+    h.manager
+        .add_capture(NewDownload {
+            handover_id: "second".into(),
+            ..capture.clone()
+        })
+        .await?;
+    let choice = choice_requested(&mut ui).await;
+    let mut typed = select(&choice.options[0].id);
+    typed.file_name = Some("clip".into());
+    h.manager.choose_media(choice.id, typed).await?;
+    let question = next_event(&mut ui, "the name is asked about", |e| match e {
+        UiEvent::FileExistsRequested(question) => Some(question.clone()),
+        _ => None,
+    })
+    .await;
+    let fetched = server.seen_at("hls/720/seg0.ts").len();
+    h.manager.answer_file_exists(
+        question.id,
+        FileExistsAnswer {
+            choice: FileExistsChoice::Replace,
+            remember: false,
+        },
+    )?;
+    h.wait_status(question.download, DownloadStatus::Completed)
+        .await;
+    let left = folder.join("clip.wcmedia");
+    let refetched = server.seen_at("hls/720/seg0.ts").len() - fetched;
+    assert!(
+        refetched == 0 && !left.exists(),
+        "fetched the first segment {refetched} more time(s); stranded folder {} exists: {}",
+        left.display(),
+        left.exists()
+    );
+    Ok(())
+}

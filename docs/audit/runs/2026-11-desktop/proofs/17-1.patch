+/// 17-1: a list another download left in the work folder is saved as this download.
+#[tokio::test]
+async fn proof_a_new_link_does_not_take_a_list_another_link_left() {
+    let dir = tempfile::tempdir().unwrap();
+    let output = dir.path().join("Clip.mp4");
+    std::fs::write(&output, b"the person's file").unwrap();
+    let work = wirecatch_media::work_dir(&output);
+    std::fs::create_dir(&work).unwrap();
+    let old = work.join("video.mp4");
+    std::fs::write(&old, b"the earlier download's video").unwrap();
+    workdir::Downloaded::of_media(std::slice::from_ref(&old))
+        .write(&work)
+        .await
+        .unwrap();
+    let job = proof_job(
+        dir.path(),
+        &output,
+        "https://example.com/another-video",
+        Taken::Replace,
+    );
+    let what = MediaJob::Page {
+        video: None,
+        audio: None,
+        output: None,
+        keep_ext: None,
+        conversion_failed: false,
+    };
+    let end = run(
+        job,
+        what,
+        &MediaProgress::default(),
+        &CancellationToken::new(),
+    )
+    .await;
+    let saved = std::fs::read(&output).unwrap();
+    assert_ne!(
+        saved, b"the earlier download's video",
+        "a link that was never read or downloaded completed as {end:?} with another link's video"
+    );
+}

+/// 17-1: a marker names no link, so one page's part is joined with another's.
+#[tokio::test]
+async fn proof_a_part_marker_belongs_to_its_link() {
+    let dir = tempfile::tempdir().unwrap();
+    let output = dir.path().join("Clip.mp4");
+    let work = wirecatch_media::work_dir(&output);
+    std::fs::create_dir(&work).unwrap();
+    std::fs::write(work.join("video.mp4"), b"the earlier page's video").unwrap();
+    std::fs::write(work.join(workdir::marker("video")), "video.mp4").unwrap();
+    let job = proof_job(
+        dir.path(),
+        &output,
+        "https://example.com/another-video",
+        Taken::Replace,
+    );
+    let format: Format = serde_json::from_value(serde_json::json!({
+        "format_id": "137", "ext": "mp4", "vcodec": "avc1", "acodec": "none",
+        "url": "http://127.0.0.1:9/another-video.mp4", "protocol": "https"
+    }))
+    .unwrap();
+    let got = super::page::fetch_part(
+        &job,
+        &format,
+        "video",
+        PrivateNetwork::Allow,
+        &work,
+        &MediaProgress::default(),
+        &CancellationToken::new(),
+    )
+    .await;
+    assert!(
+        !matches!(got, Ok(Some(_))),
+        "the part of another page was reused without any request: {:?}",
+        got.ok()
+    );
+}

# Run: git apply this in a worktree of HEAD, then cargo test -p wirecatch-settings audit_ (Windows). Output: 2 FAILED, 'accepted with no flag: used PortablePath("{Home}/AppData/Local/Wirecatch/addons/media/ffmpeg"), reason None, outside false' and 'accepted from a settings file: [ffmpeg, yt-dlp, Wirecatch, Programs/Some App, .ssh, WindowsPowerShell]'.
diff --git a/crates/settings/src/folders.rs b/crates/settings/src/folders.rs
index afd18a66d..6cb4613db 100644
--- a/crates/settings/src/folders.rs
+++ b/crates/settings/src/folders.rs
@@ -738,4 +738,23 @@ mod tests {
         folders.downloads = PathBuf::from(elsewhere).join("Downloads");
         assert!(!folders.is_outside_user_folders(&folders.downloads.join("x")));
     }
+
+    /// Audit proof: folders whose files Wirecatch or Windows tools run or read as their own, accepted from a settings file.
+    #[cfg(windows)]
+    #[test]
+    fn audit_folders_of_programs_and_of_the_app_are_refused_from_a_file() {
+        let folders = KnownFolders::under_home(home());
+        let accepted: Vec<&str> = [
+            "{Home}/AppData/Local/Wirecatch/addons/media/ffmpeg",
+            "{Home}/AppData/Local/Wirecatch/addons/media/yt-dlp",
+            "{Home}/AppData/Local/Wirecatch",
+            "{Home}/AppData/Local/Programs/Some App",
+            "{Home}/.ssh",
+            "{Documents}/WindowsPowerShell",
+        ]
+        .into_iter()
+        .filter(|path| !refused(&folders, path))
+        .collect();
+        assert!(accepted.is_empty(), "accepted from a settings file: {accepted:#?}");
+    }
 }
diff --git a/crates/settings/src/settings_file.rs b/crates/settings/src/settings_file.rs
index 949960492..358d54b65 100644
--- a/crates/settings/src/settings_file.rs
+++ b/crates/settings/src/settings_file.rs
@@ -858,4 +858,33 @@ mod tests {
         assert_eq!(flagged.reason, None);
         assert!(flagged.outside_user_folders);
     }
+
+    /// Audit proof: a file sends downloads beside the programs Wirecatch runs, and the report does not flag it.
+    #[cfg(windows)]
+    #[test]
+    fn audit_a_file_cannot_send_downloads_beside_the_add_ons_programs() {
+        let beside_ffmpeg = "{Home}/AppData/Local/Wirecatch/addons/media/ffmpeg";
+        let mut settings = default_settings();
+        settings.default_folder = PortablePath(beside_ffmpeg.into());
+        let profile = SettingsFile {
+            format_version: SETTINGS_FILE_FORMAT_VERSION,
+            app_version: "0.1.0".into(),
+            exported_at: UnixMillis(0),
+            settings,
+            queues: vec![],
+            proxy_servers: Vec::new(),
+            addons: vec![],
+        };
+        let imported = merge(profile, &[default_queue()], &folders(), || QueueId(2)).unwrap();
+        let first = &imported.summary.folders[0];
+        assert!(
+            first.reason.is_some() || first.outside_user_folders,
+            "accepted with no flag: used {:?}, reason {:?}, outside {}",
+            first.used,
+            first.reason,
+            first.outside_user_folders
+        );
+        assert_eq!(imported.settings.default_folder, PortablePath("{Downloads}".into()));
+    }
+
 }

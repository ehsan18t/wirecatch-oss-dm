+/// Xcrash-and-resume-2: the engine's rename reached the disk, the resume file's deletion did not.
+#[tokio::test(flavor = "multi_thread", worker_threads = 2)]
+async fn a_finished_file_beside_its_resume_file_is_not_downloaded_again() -> TestResult {
+    let slow = throttled_server(256 * KIB, 64 * KIB).await?;
+    let mut h = Harness::new().await?;
+    let row = h.add(&slow.url("f.bin")).await?;
+    h.wait_for(row.id, "the server's answer", |r| r.done > 0)
+        .await;
+    h.manager.pause(row.id).unwrap();
+    let row = h.wait_status(row.id, DownloadStatus::Paused).await;
+    h.shutdown().await;
+    let [part, state] = partial_files(&row.path);
+    assert!(state.exists());
+    std::fs::remove_file(&part)?;
+    std::fs::write(&row.path, &slow.data)?;
+
+    h.reopen().await?;
+    let status = h.row(row.id).status;
+    if status != DownloadStatus::Completed {
+        h.manager.resume(row.id).unwrap();
+    }
+    let done = h.wait_status(row.id, DownloadStatus::Completed).await;
+    println!("BEFORE RESUME {status:?} FINISHED AT {}", done.file_name);
+    assert_eq!(
+        done.path, row.path,
+        "a second copy of the file was downloaded"
+    );
+    Ok(())
+}

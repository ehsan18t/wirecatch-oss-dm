{
  "name": "@wirecatch/desktop",
  "version": "0.1.0",
  "private": true,
  "license": "GPL-3.0-only",
  "description": "Wirecatch desktop app: Tauri 2 shell with a Svelte 5 interface.",
  "type": "module",
  "scripts": {
    "dev": "tauri dev",
    "dev:web": "vite dev",
    "dev:mock": "vite dev --mode mock --open",
    "build": "vite build && node scripts/check-bundle.mjs",
    "build:mock": "vite build --mode mock",
    "build:gallery": "vite build --mode gallery",
    "build:tauri": "node scripts/prepare-bridge.mjs && tauri build --debug --config src-tauri/tauri.bundle.conf.json",
    "bundle": "node scripts/prepare-bridge.mjs --release && tauri build --config src-tauri/tauri.bundle.conf.json",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
    "test": "vitest run",
    "e2e": "playwright test",
    "e2e:screenshots": "playwright test -c playwright.screenshots.config.ts",
    "e2e:perf": "pnpm build:mock && playwright test -c playwright.perf.config.ts",
    "e2e:gallery": "pnpm build:gallery && playwright test -c playwright.gallery.config.ts",
    "tauri": "tauri"
  },
  "dependencies": {
    "@fontsource-variable/instrument-sans": "5.3.0",
    "@lucide/svelte": "1.55.0",
    "@tauri-apps/api": "2.12.3",
    "@tauri-apps/plugin-dialog": "2.8.2",
    "@wirecatch/product": "workspace:*",
    "@wirecatch/protocol": "workspace:*",
    "@wirecatch/ui": "workspace:*",
    "@wirecatch/units": "workspace:*"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@iconify-json/lucide": "catalog:",
    "@playwright/test": "1.64.0",
    "@sveltejs/vite-plugin-svelte": "catalog:",
    "@tailwindcss/vite": "catalog:",
    "@tauri-apps/cli": "2.12.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/svelte": "catalog:",
    "@testing-library/user-event": "catalog:",
    "@types/node": "catalog:",
    "@wirecatch/eslint-config": "workspace:*",
    "axe-core": "catalog:",
    "jsdom": "catalog:",
    "svelte": "catalog:",
    "svelte-check": "catalog:",
    "tailwindcss": "catalog:",
    "typescript": "catalog:",
    "unplugin-icons": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}

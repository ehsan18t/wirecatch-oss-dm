{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Wirecatch",
  "mainBinaryName": "wirecatch-app",
  "identifier": "app.wirecatch.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev:web",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "Wirecatch",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 600,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "deb", "rpm", "appimage"],
    "publisher": "TODO-PRODUCT-PUBLISHER-LEGAL-NAME",
    "copyright": "Wirecatch contributors. Licensed under GPL-3.0-only.",
    "license": "GPL-3.0-only",
    "licenseFile": "../../../LICENSE",
    "category": "Utility",
    "shortDescription": "A fast download manager that just works",
    "longDescription": "Wirecatch downloads files from the web quickly and reliably, catches downloads from your browser, and keeps queues, schedules and speed limits simple.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "perMachine",
        "installerIcon": "icons/icon.ico",
        "startMenuFolder": "Wirecatch",
        "installerHooks": "windows/hooks.nsh"
      }
    },
    "linux": {
      "deb": {
        "section": "net",
        "depends": ["libayatana-appindicator3-1"],
        "preRemoveScript": "linux/prerm.sh"
      },
      "rpm": {
        "depends": ["libayatana-appindicator-gtk3"],
        "preRemoveScript": "linux/prerm.sh"
      }
    }
  }
}

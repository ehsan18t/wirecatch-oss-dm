{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "What the main window uses: the wirecatch://event stream, the app's name for titles, the file and folder pickers, dragging the frameless window by its title bar (a double-click there maximizes it), and the app's commands except the ones only a download window has a use for (D43).",
  "windows": ["main"],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "core:app:allow-name",
    "core:window:allow-start-dragging",
    "core:window:allow-internal-toggle-maximize",
    "dialog:allow-open",
    "dialog:allow-save",
    "allow-list-downloads",
    "allow-add-download",
    "allow-pause",
    "allow-resume",
    "allow-cancel",
    "allow-remove",
    "allow-retry",
    "allow-refresh-link",
    "allow-keep-original",
    "allow-move-to-queue",
    "allow-reorder",
    "allow-pause-all",
    "allow-resume-all",
    "allow-list-queues",
    "allow-create-queue",
    "allow-update-queue",
    "allow-delete-queue",
    "allow-set-queue-paused",
    "allow-start-queue-now",
    "allow-get-settings",
    "allow-change-settings",
    "allow-export-settings",
    "allow-preview-import",
    "allow-import-settings",
    "allow-pending-confirmations",
    "allow-open-file",
    "allow-open-folder",
    "allow-set-download-folder",
    "allow-take-launch-links",
    "allow-pending-media-choices",
    "allow-pending-addon-requests",
    "allow-list-addons",
    "allow-install-addon",
    "allow-update-addon",
    "allow-remove-addon",
    "allow-cancel-addon-operation",
    "allow-check-addon-updates",
    "allow-suffix-list",
    "allow-check-suffix-list",
    "allow-show-question-windows",
    "allow-show-progress-window",
    "allow-main-window-ready",
    "allow-control-window",
    "allow-window-frame",
    "allow-set-maximize-button",
    "allow-system-appearance",
    "allow-startup-notices",
    "allow-show-set-aside-list",
    "allow-take-captured",
    "allow-report-unreadable-event"
  ]
}

{
  "name": "@wirecatch/extension",
  "version": "0.1.0",
  "private": true,
  "license": "GPL-3.0-only",
  "description": "Wirecatch browser extension for Chromium and Firefox: captures downloads and hands them to the Wirecatch app.",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox --mv3",
    "build": "wxt build && wxt build -b firefox --mv3",
    "build:dev": "wxt build --mode development",
    "build:store": "wxt zip --mode store",
    "build:firefox": "wxt build -b firefox --mv3",
    "sign:firefox": "node scripts/sign-firefox.mjs",
    "zip": "wxt zip && wxt zip -b firefox --mv3",
    "check": "wxt prepare && svelte-check --tsconfig ./tsconfig.json --fail-on-warnings --output human",
    "lint": "eslint . --max-warnings 0 && prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run",
    "postinstall": "wxt prepare"
  },
  "dependencies": {
    "@wirecatch/protocol": "workspace:*"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@testing-library/svelte": "5.4.2",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "24.19.2",
    "@wxt-dev/module-svelte": "2.0.5",
    "axe-core": "4.14.0",
    "eslint": "10.12.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-svelte": "3.23.1",
    "globals": "17.13.0",
    "jsdom": "30.1.2",
    "prettier": "3.9.10",
    "prettier-plugin-svelte": "4.1.1",
    "svelte": "5.57.2",
    "svelte-check": "4.7.6",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1",
    "vitest": "5.0.3",
    "web-ext": "10.7.0",
    "wxt": "0.21.4"
  }
}

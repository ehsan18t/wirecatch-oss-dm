{
  "name": "@wirecatch/extension",
  "version": "0.1.0",
  "private": true,
  "license": "GPL-3.0-only",
  "description": "Wirecatch browser extension for Chromium and Firefox: captures downloads and hands them to the Wirecatch app.",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox --mv3",
    "preview": "vite --config preview/vite.config.ts",
    "build": "wxt build && wxt build -b firefox --mv3",
    "build:dev": "wxt build --mode development",
    "build:store": "node ../../scripts/gate.mjs publish-extension && wxt zip --mode store",
    "build:firefox": "wxt build -b firefox --mv3",
    "sign:firefox": "node ../../scripts/gate.mjs publish-extension && node scripts/sign-firefox.mjs",
    "zip": "wxt zip && wxt zip -b firefox --mv3",
    "check": "wxt prepare && svelte-check --tsconfig ./tsconfig.json --fail-on-warnings --output human",
    "test": "vitest run",
    "e2e": "playwright test",
    "postinstall": "wxt prepare"
  },
  "dependencies": {
    "@wirecatch/product": "workspace:*",
    "@wirecatch/protocol": "workspace:*",
    "@wirecatch/ui": "workspace:*",
    "@wirecatch/units": "workspace:*",
    "tldts": "7.4.18"
  },
  "devDependencies": {
    "@fontsource/dejavu-sans": "5.3.0",
    "@iconify-json/lucide": "catalog:",
    "@playwright/test": "1.64.0",
    "@sveltejs/vite-plugin-svelte": "catalog:",
    "@tailwindcss/vite": "catalog:",
    "@testing-library/svelte": "catalog:",
    "@testing-library/user-event": "catalog:",
    "@types/node": "catalog:",
    "@wirecatch/eslint-config": "workspace:*",
    "@wxt-dev/module-svelte": "2.0.5",
    "axe-core": "catalog:",
    "jsdom": "catalog:",
    "svelte": "catalog:",
    "svelte-check": "catalog:",
    "tailwindcss": "catalog:",
    "typescript": "catalog:",
    "unplugin-icons": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:",
    "web-ext": "10.7.0",
    "wxt": "0.21.4"
  }
}

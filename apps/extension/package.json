{
  "name": "@wirecatch/extension",
  "version": "0.1.0",
  "private": true,
  "license": "GPL-3.0-only",
  "description": "Wirecatch browser extension for Chromium and Firefox: captures downloads and hands them to the Wirecatch app.",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox --mv3",
    "build": "wxt build && wxt build -b firefox --mv3",
    "build:dev": "wxt build --mode development",
    "build:store": "node ../../scripts/gate.mjs publish && wxt zip --mode store",
    "build:firefox": "wxt build -b firefox --mv3",
    "sign:firefox": "node ../../scripts/gate.mjs publish && node scripts/sign-firefox.mjs",
    "zip": "wxt zip && wxt zip -b firefox --mv3",
    "check": "wxt prepare && svelte-check --tsconfig ./tsconfig.json --fail-on-warnings --output human",
    "lint": "eslint . --max-warnings 0 && prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run",
    "postinstall": "wxt prepare"
  },
  "dependencies": {
    "@wirecatch/product": "workspace:*",
    "@wirecatch/protocol": "workspace:*",
    "@wirecatch/units": "workspace:*"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "catalog:",
    "@testing-library/svelte": "catalog:",
    "@testing-library/user-event": "catalog:",
    "@types/node": "catalog:",
    "@wirecatch/eslint-config": "workspace:*",
    "@wxt-dev/module-svelte": "2.0.5",
    "axe-core": "catalog:",
    "eslint": "catalog:",
    "jsdom": "catalog:",
    "prettier": "catalog:",
    "prettier-plugin-svelte": "catalog:",
    "svelte": "catalog:",
    "svelte-check": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "web-ext": "10.7.0",
    "wxt": "0.21.4"
  }
}

{
  "name": "wirecatch-workspace",
  "private": true,
  "license": "GPL-3.0-only",
  "packageManager": "pnpm@10.33.3",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "gate": "node scripts/gate.mjs",
    "prepare": "node scripts/install-hooks.mjs",
    "protocol:generate": "pnpm --filter @wirecatch/protocol generate",
    "check": "pnpm -r --if-present check",
    "lint": "pnpm -r --if-present lint",
    "test": "pnpm -r --if-present test",
    "build": "pnpm -r --if-present build"
  },
  "pnpm": {
    "overrides": {
      "shell-quote@>=1.8.4 <1.11.0": ">=1.11.0",
      "cookie@<0.7.0": ">=0.7.0 <0.8.0"
    },
    "auditConfig": {
      "ignoreGhsas": [
        "GHSA-86w9-cpqp-85rv"
      ]
    }
  }
}

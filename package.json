{
  "name": "wirecatch-workspace",
  "private": true,
  "license": "GPL-3.0-only",
  "type": "module",
  "packageManager": "pnpm@12.11.2+sha512.25a51652a196785af5f28bda6dfe8dc582ebefa4ac1d180221ce1390231c5fb76637822ea4b6e4633ce74acdcb0a77f725af11bad38177fdeddaee818a955cb9",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "gate": "node scripts/gate.mjs",
    "prepare": "node scripts/install-hooks.mjs",
    "protocol:generate": "pnpm --filter @wirecatch/protocol generate",
    "product:generate": "node scripts/product/generate.mjs",
    "check": "pnpm -r --if-present check",
    "lint": "pnpm -r --if-present lint && eslint scripts eslint.config.js --max-warnings 0 && prettier --check scripts eslint.config.js",
    "test": "pnpm -r --if-present test && node --test \"scripts/**/*.test.mjs\"",
    "build": "pnpm -r --if-present build"
  },
  "devDependencies": {
    "@wirecatch/eslint-config": "workspace:*",
    "eslint": "catalog:",
    "prettier": "catalog:",
    "prettier-plugin-svelte": "catalog:",
    "smol-toml": "catalog:"
  }
}

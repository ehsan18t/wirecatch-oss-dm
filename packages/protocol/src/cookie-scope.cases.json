{
  "about": "Which cookies go with a captured request (D112). The app's cookie_scope tests and the extension's cookie tests read this file, so both decide alike. Each cookie in `jar` is named after its SameSite value.",
  "sites": [
    ["https://www.example.com/a", "https://example.com"],
    ["http://www.example.com/a", "http://example.com"],
    ["https://a.b.example.com/", "https://example.com"],
    ["https://example.com/", "https://example.com"],
    ["https://shop.example.co.uk/", "https://example.co.uk"],
    ["https://news.example.com.au/", "https://example.com.au"],
    ["https://alice.github.io/", "https://alice.github.io"],
    ["https://cdn.alice.github.io/", "https://alice.github.io"],
    ["https://bucket.s3.amazonaws.com/", "https://bucket.s3.amazonaws.com"],
    ["https://victim.myshopify.com/", "https://victim.myshopify.com"],
    ["https://cdn.victim.myshopify.com/", "https://victim.myshopify.com"],
    ["https://bucket.r2.dev/", "https://bucket.r2.dev"],
    ["https://bucket.s3.us-east-2.amazonaws.com/", "https://bucket.s3.us-east-2.amazonaws.com"],
    ["https://shop.example.uk.com/", "https://example.uk.com"],
    ["https://www.school.k12.ca.us/", "https://school.k12.ca.us"],
    ["https://www.example.ac.jp/", "https://example.ac.jp"],
    ["https://www.example.xn--p1ai/", "https://example.xn--p1ai"],
    ["https://myshopify.com/", "https://myshopify.com"],
    ["https://co.uk/", "https://co.uk"],
    ["http://localhost:8080/", "http://localhost"],
    ["http://192.168.1.10/", "http://192.168.1.10"],
    ["http://[::1]/", "http://[::1]"],
    ["https://WWW.Example.COM./", "https://example.com"],
    ["https://attacker..com/", "https://attacker..com"],
    ["https://a..example.com/", "https://a..example.com"],
    ["blob:https://example.com/1", null],
    ["ftp://example.com/a", null],
    ["not a url", null]
  ],
  "jar": ["no_restriction", "lax", "strict", "unspecified"],
  "requests": [
    {
      "why": "a same-site link sends every cookie",
      "url": "https://files.example.com/report.pdf",
      "request": { "initiator": "https://example.com/account", "navigation": true },
      "sent": ["no_restriction", "lax", "strict", "unspecified"]
    },
    {
      "why": "a link from another site never sends Strict, but sends Lax",
      "url": "https://files.example.com/report.pdf",
      "request": { "initiator": "https://other.test/links", "navigation": true },
      "sent": ["no_restriction", "lax", "unspecified"]
    },
    {
      "why": "media another site loads sends only SameSite=None",
      "url": "https://files.example.com/report.pdf",
      "request": {
        "initiator": "https://other.test/watch",
        "top_level": "https://other.test/watch",
        "navigation": false
      },
      "sent": ["no_restriction"]
    },
    {
      "why": "an unknown starting page counts as another site",
      "url": "https://files.example.com/report.pdf",
      "request": { "initiator": null, "navigation": true },
      "sent": ["no_restriction", "lax", "unspecified"]
    },
    {
      "why": "the scheme counts, as in Chromium",
      "url": "https://cdn.example.com/file.zip",
      "request": { "initiator": "http://www.example.com/page", "navigation": true },
      "sent": ["no_restriction", "lax", "unspecified"]
    },
    {
      "why": "neighbours on shared hosting are different sites",
      "url": "https://alice.github.io/f.zip",
      "request": { "initiator": "https://bob.github.io/", "navigation": true },
      "sent": ["no_restriction", "lax", "unspecified"]
    },
    {
      "why": "a redirect from another site makes the request cross-site",
      "url": "https://cdn.example.com/file.zip",
      "request": {
        "initiator": "https://www.example.com/page",
        "original_url": "https://tracker.test/r",
        "navigation": true
      },
      "sent": ["no_restriction", "lax", "unspecified"]
    },
    {
      "why": "a same-site frame inside a page on another site is cross-site",
      "url": "https://cdn.example.com/file.zip",
      "request": {
        "initiator": "https://www.example.com/embed",
        "top_level": "https://news.test/",
        "navigation": false
      },
      "sent": ["no_restriction"]
    },
    {
      "why": "one shared-host customer's link to another withholds Strict",
      "url": "https://victim.myshopify.com/export",
      "request": { "initiator": "https://attacker.myshopify.com/links", "navigation": true },
      "sent": ["no_restriction", "lax", "unspecified"]
    },
    {
      "why": "the shared host itself is another site",
      "url": "https://victim.myshopify.com/export",
      "request": { "initiator": "https://myshopify.com/", "navigation": true },
      "sent": ["no_restriction", "lax", "unspecified"]
    },
    {
      "why": "a look-alike host is another site",
      "url": "https://victim.myshopify.com/export",
      "request": { "initiator": "https://victim.myshopify.com.evil.test/", "navigation": true },
      "sent": ["no_restriction", "lax", "unspecified"]
    },
    {
      "why": "a subdomain of the customer is the same site",
      "url": "https://victim.myshopify.com/export",
      "request": { "initiator": "https://admin.victim.myshopify.com/", "navigation": true },
      "sent": ["no_restriction", "lax", "strict", "unspecified"]
    },
    {
      "why": "media one shared-host customer loads from another",
      "url": "https://victim.myshopify.com/v.mp4",
      "request": {
        "initiator": "https://attacker.myshopify.com/watch",
        "top_level": "https://attacker.myshopify.com/watch",
        "navigation": false
      },
      "sent": ["no_restriction"]
    },
    {
      "why": "an address that is not a web address counts as another site",
      "url": "blob:https://example.com/1",
      "request": { "initiator": "https://example.com/", "navigation": true },
      "sent": ["no_restriction", "lax", "unspecified"]
    }
  ]
}
